(melange.emit
 (target output)
 (alias playground-runtime-js)
 (libraries
  melange
  ; melange doesn't include belt and dom anymore, including them below leads to
  ; `_build/default/playground/output/node_modules` to include the runtimes
  melange.belt
  melange.dom)
 (modules) ; Empty, we just want to the js artifacts from the libraries
 (module_systems esm))

(rule
 (deps
  %{bin:js_of_ocaml}
  %{bin:ocamlfind}
  (package reason-react))
 (target reason-react-cmijs.js)
 (action
  (run bash %{dep:build_fs.sh} reason-react %{target})))

(executable
 (name format)
 (modules format)
 (modes js)
 (libraries js_of_ocaml ocamlformat-mlx-lib ppxlib reason reason-to-mlx))

(rule
 (alias playground-assets)
 (deps %{bin:mel_playground.bc.js})
 (target mel_playground.bc.js)
 (action
  (copy %{deps} %{target})))

(rule
 (alias playground-assets)
 (deps %{bin:js_of_ocaml} %{bin:ocamlfind} (package melange))
 (target melange-cmijs.js)
 (action
  (run bash %{dep:build_fs.sh} melange %{target})))

(rule
 (alias playground-assets)
 (deps
  (alias playground-runtime-js)
  format.bc.js
  reason-react-cmijs.js
  mel_playground.bc.js
  melange-cmijs.js)
 (action
  (echo "assets generated")))

(rule
 (alias runtest)
 (deps
  test.cjs
  package.json
  src/examples.js
  format.bc.js
  mel_playground.bc.js
  melange-cmijs.js
  reason-react-cmijs.js)
 (action
  (run
   node
   %{dep:test.cjs}
   %{dep:reason-react-cmijs.js}
   %{dep:mel_playground.bc.js}
   %{dep:melange-cmijs.js}
   %{dep:format.bc.js})))
